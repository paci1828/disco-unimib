<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="16dp">
        <TextView android:id="@+id/detailTitleTextView" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:text="@string/ricevimento_dettagli"
            android:textSize="22sp" android:textStyle="bold" />
        <TextView android:id="@+id/studenteNameTextView" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="16dp" android:textSize="18sp" />
        <TextView android:id="@+id/dateTimeTextView" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="8dp" />
        <TextView android:id="@+id/motivazioneTextView" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="8dp" />
        <TextView android:id="@+id/statoTextView" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="8dp" android:textStyle="bold" />
        <ProgressBar android:id="@+id/progressBar" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:layout_gravity="center_horizontal" />
        <Button android:id="@+id/accettaButton" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:text="@string/ricevimento_accetta" android:visibility="gone" />
        <Button android:id="@+id/rifiutaButton" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:text="@string/ricevimento_rifiuta" android:visibility="gone" />
        <Button android:id="@+id/annullaButton" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:text="@string/ricevimento_annulla" android:visibility="gone" />
        <Button android:id="@+id/riprogrammaButton" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:text="@string/ricevimento_riprogramma" android:visibility="gone" />
        <Button android:id="@+id/collegatoButton" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:visibility="gone" />
        <TextView android:id="@+id/syncDescrizioneTextView" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="24dp" />
        <TextView android:id="@+id/syncStatoTextView" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="8dp"
            android:accessibilityLiveRegion="polite" />
        <Button android:id="@+id/googleSyncButton" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:text="@string/google_collega" android:visibility="gone" />
        <Button android:id="@+id/emailVerificataButton" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:text="@string/google_conferma_email" android:visibility="gone" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
