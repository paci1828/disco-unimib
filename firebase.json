{
  "firestore": {
    "database": "(default)",
    "location": "europe-west1",
    "edition": "standard",
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "auth": {
    "providers": {
      "emailPassword": true
    }
  },
  "emulators": {
    "firestore": {
      "host": "127.0.0.1",
      "port": 8089,
      "edition": "standard"
    },
    "ui": {
      "enabled": false
    },
    "singleProjectMode": true
  }
}
